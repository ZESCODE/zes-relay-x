{
  "name": "zes-relay-control-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Frost-styled Next.js control panel that monitors and manages the pol_relay.py OpenAI-compatible relay",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/relay-integration.test.ts",
    "demo:upstream": "node tools/demo-upstream.mjs",
    "seed": "node tools/seed-traffic.mjs",
    "bundle": "node tools/bundle.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
