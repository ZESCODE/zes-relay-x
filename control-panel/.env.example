# ─────────────────────────────────────────────────────────────────────────────
# ZES Relay Control Panel — environment
# Copy to .env.local (dev) or .env (container) and adjust.
# Every value below is optional: the documented default is shown after "=".
# ─────────────────────────────────────────────────────────────────────────────

# ── Panel server ────────────────────────────────────────────────────────────
# Interface to bind. Refuses anything other than a loopback address unless
# PANEL_ALLOW_PUBLIC=true (deliberate friction so the panel is not exposed by
# accident).
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
PANEL_ALLOW_PUBLIC=false

# CSP frame-ancestors for embedding behind a trusted proxy. When set (or when
# PANEL_EMBEDDABLE=true) X-Frame-Options is omitted so the CSP value wins.
# PANEL_FRAME_ANCESTORS='none'
# PANEL_EMBEDDABLE=false

# Absolute path for runtime state. Empty ⇒ <repo>/data (or <cwd>/data).
PANEL_DATA_DIR=

# Session signing secret. Empty ⇒ generated once and stored in
# data/.session-secret (mode 0600).
PANEL_SESSION_SECRET=
PANEL_SESSION_TTL_HOURS=12
# Set the first-run admin. PANEL_ADMIN_PASSWORD empty ⇒ a random one-time
# password is generated and printed to the panel log exactly once.
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=

# Honour X-Forwarded-For when rate limiting (only behind a trusted proxy).
PANEL_TRUST_PROXY=false

# Cookie SameSite policy: lax (default) | strict | none.
# Use "none" when the panel is embedded in a cross-site iframe; it is then
# always sent with Secure, as browsers require.
PANEL_COOKIE_SAMESITE=lax

# ── Relay process ───────────────────────────────────────────────────────────
# Path to the relay entry point, relative to this directory or absolute.
PANEL_RELAY_SCRIPT=../pol_relay.py
PANEL_PYTHON_BIN=python3
# Fallback script used when PANEL_RELAY_SCRIPT is missing.
PANEL_RELAY_SCRIPT_FALLBACK=../pol-relay.sh

# How the panel talks to the relay (read from data/.env at runtime too).
POL_RELAY_PORT=7179
POL_UPSTREAM_BASE=https://gen.pollinations.ai/v1
POL_API_KEY=
POL_SKIP_AUTH=true

# Optional bearer token the panel sends to the relay (only meaningful when the
# relay runs with POL_SKIP_AUTH=true and the upstream requires a key).
PANEL_RELAY_BEARER=

# ── Relay manager tuning ────────────────────────────────────────────────────
PANEL_HEALTH_INTERVAL_MS=5000
PANEL_HEALTH_TIMEOUT_MS=2000
PANEL_AUTORESTART=3
PANEL_SHUTDOWN_GRACE_MS=5000
PANEL_START_TIMEOUT_MS=8000
PANEL_RESTART_BACKOFF_MS=1000

# ── Limits & buffers ────────────────────────────────────────────────────────
PANEL_LOGIN_RATE_LIMIT=5
PANEL_CHAT_RATE_LIMIT=60
PANEL_RATE_WINDOW_MS=60000
PANEL_MAX_LOG_ENTRIES=5000
PANEL_METRICS_SAMPLES=3600
PANEL_METRICS_BUCKETS=1440
PANEL_METRICS_TICK_MS=5000
# Cadence of the SSE feed consumed by the dashboard (BUILD-PROMPT: 2s).
PANEL_METRICS_STREAM_MS=2000
PANEL_PANEL_LOG_MAX_BYTES=5242880
PANEL_PANEL_LOG_KEEP=3
PANEL_CHAT_MAX_BODY_BYTES=1048576
PANEL_REQUEST_TIMEOUT_MS=120000
PANEL_MAX_PRESETS=200
PANEL_MAX_BACKUPS=50
PANEL_MAX_ERRORS=100
